{
  "name": "nightreign-reference-notebook",
  "version": "0.0.0",
  "private": true,
  "homepage": "https://PanZ1Haaaaaaang.github.io/NightreignQuickRef",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
