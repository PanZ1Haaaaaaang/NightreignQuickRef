    "deploy": "gh-pages -d dist",
    "prepare": "husky"
  },
  "dependencies": {
    "@ant-design/charts": "^2.6.2",
    "@ant-design/colors": "^7.2.1",
    "@ant-design/icons": "^6.0.0",
    "@ant-design/plots": "^2.6.3",
    "@giscus/react": "^3.1.0",
    "@types/lodash": "^4.17.20",
    "antd": "^5.26.7",
    "lodash": "^4.17.21",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vercount-react": "^0.1.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "terser": "^5.43.1",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  },
  "lint-staged": {
