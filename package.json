{
  "name": "nightreign-reference-notebook",
  "version": "0.0.0",
  "private": true,
  "homepage": "https://PanZ1Haaaaaaang.github.io/NightreignQuickRef",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "preview": "vite preview",
    "deploy": "pnpm run build && gh-pages -d dist",
    "prepare": "husky"
  },
  "dependencies": {
    "@ant-design/colors": "^8.0.1",
    "@ant-design/icons": "6.3.4",
    "@ant-design/plots": "2.6.8",
    "@giscus/react": "^3.1.0",
    "antd": "6.7.2",
    "lodash": "^4.18.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vercount-react": "^0.1.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/lodash": "^4.17.27",
    "@types/react": "19.3.1",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "terser": "^5.51.4",
    "typescript": "6.0.3",
    "vite": "8.3.8"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.css": [
      "oxfmt"
    ]
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.28.5"
